{
  "name": "digital-mudir-dokan",
  "version": "1.1.0",
  "private": true,
  "description": "Build tooling for the Digital Mudir Dokan WordPress theme.",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/theme.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/theme.css --watch",
    "audit:safelist": "node ./tools/audit-safelist.js",
    "release": "npm run build:css && npm run audit:safelist",
    "zip": "git archive --format=zip --prefix=digital-mudir-dokan/ -o digital-mudir-dokan.zip HEAD"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
